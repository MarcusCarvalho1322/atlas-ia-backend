# ═══════════════════════════════════════════════════════════════
# atlas-geo — variáveis de ambiente (defina no Railway em Variables)
# ═══════════════════════════════════════════════════════════════

# Obrigatória — chave Claude para gerar diagnósticos e peças.
# Pode ser a mesma chave que o SafraCheck.IA já usa.
ANTHROPIC_API_KEY=""

# Recomendado — protege o serviço contra uso por terceiros.
# Escolha uma senha longa qualquer; o mesmo valor vai no front-end do ATLAS-IA.
ATLAS_API_TOKEN=""

# Preenchida automaticamente pelo Railway ao adicionar o plugin Postgres
# (Add Service → Database → PostgreSQL). Não precisa configurar à mão.
DATABASE_URL=""

# Opcional — restrinja quem pode chamar a API (domínio do front-end publicado).
# Deixe "*" enquanto estiver testando.
ALLOWED_ORIGINS="*"

# Opcional — modelo Claude usado para diagnósticos e peças.
ATLAS_ANTHROPIC_MODEL="claude-sonnet-4-5-20250929"

# ═══ Prospecção — base pública do IBAMA ═══
# Pasta onde os CSVs anuais de autos de infração são gravados.
# O pacote é rebaixado por POST /api/prospeccao/atualizar (o IBAMA republica diariamente).
BASE_IBAMA_DIR="./dados_ibama"
# Hora (0-23, UTC) em que a rotina diária de mineração roda sozinha.
# Vazio desliga o agendamento embutido. Ex.: 09 = 06h de Brasília.
ROTINA_DIARIA_HORA="09"
